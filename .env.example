# For static hosting on GitHub Pages:
# Optional: connect a verified form provider endpoint such as Formspree.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
# Without it, the form opens a pre-filled email draft to the current contact address.
# IMPORTANT: This value is PUBLIC in the browser bundle (do not put API keys here).
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
